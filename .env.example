# NEXUS Research Agent — ключи провайдеров (копировать в .env и заполнить).
# .env в git не коммитим — только этот пример.

# OpenAI-совместимый LLM (chat/completions): Cohere v2-compat, OpenAI, Nebius…
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Tavily Search API
TAVILY_API_KEY=

# NEAR Testnet + nexus_escrow (strict contract, fallback удалён):
#   NEAR_ACCOUNT_ID + NEAR_ESCROW_CONTRACT → все платежи идут методами
#     контракта (create_task/submit_bid/accept_bid/submit_work/
#     verify_and_release). Прямого transfer'а нет.
#   NEAR_PRIVATE_KEY — ключ менеджера; в репозитории только плейсхолдер,
#     реальный ключ держи в ~/.near-credentials/testnet/<account>.json
#     или в gitignored .env.local.
#   NEAR_AGENT_ACCOUNT — аккаунт агента (research-bot.testnet).
#   NEAR_AGENT_PRIVATE_KEY / NEAR_AGENT_KEYS_JSON — его ключ; если пусто,
#     читается ~/.near-credentials/testnet/<agent>.json.
NEAR_ACCOUNT_ID=yksunder.testnet
NEAR_PRIVATE_KEY=your_private_key_here
NEAR_ESCROW_CONTRACT=nexus-escrow.yksunder.testnet
NEAR_AGENT_ACCOUNT=research-bot.testnet
NEAR_AGENT_PRIVATE_KEY=
NEAR_AGENT_KEYS_JSON=
NEAR_CREDENTIALS_DIR=~/.near-credentials/testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com

# Вайтлист доменов источников агента (через запятую; "*" — без фильтра):
# в sources попадают только авторитетные хосты, мусор выдачи отсекается
# и виден в trace как filtered. По умолчанию — NEAR-стек:
RESEARCH_SOURCE_DOMAINS=near.org,x.com,twitter.com,github.com,nearhackathon.com

# TTL кэша новостного сентимента (минуты): новости меняются медленно,
# цикл идёт раз в минуту — LLM не дёргаем на каждом тике
NEWS_CACHE_TTL_MIN=15
